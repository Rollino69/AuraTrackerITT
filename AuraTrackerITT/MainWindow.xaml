<Window x:Class="AuraTrackerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aura Tracker v2.0" Height="350" Width="400">

    <StackPanel Margin="20">

        <Label Content="Seleziona la tua azione:" FontWeight="Bold" FontSize="14"/>

        <ComboBox x:Name="cmbAzioni" Height="30" Margin="0,5,0,20"/>

        <Button x:Name="btnCalcola" Content="CALCOLA AURA" Height="40" Background="#DDDDDD" Click="BtnCalcola_Click"/>

        <TextBlock x:Name="txtRisultato" Text="In attesa..." Margin="0,20,0,10" FontSize="14" TextWrapping="Wrap"/>

        <Separator/>

        <TextBlock x:Name="txtTotale" Text="Aura Totale: 1000" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,0"/>

    </StackPanel>
</Window>